{
  "name": "visa-atlas-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @visa-atlas/web",
    "dev": "npm run dev --workspace @visa-atlas/web",
    "format:check": "npm run format:check --workspace @visa-atlas/web",
    "lint": "npm run lint --workspace @visa-atlas/web",
    "test": "npm run test --workspace @visa-atlas/web",
    "test:e2e": "npm run test:e2e --workspace @visa-atlas/web",
    "test:e2e:real": "npm run test:e2e:real --workspace @visa-atlas/web",
    "typecheck": "npm run typecheck --workspace @visa-atlas/web",
    "contracts:generate": "npm run generate --workspace @visa-atlas/contracts"
  },
  "engines": {
    "node": ">=22"
  }
}
